---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'EcomCalculators - Darmowe kalkulatory dla e-commerce', 
  description = 'Zbiór prostych, darmowych i przydatnych kalkulatorów pomagających w optymalizacji biznesu e-commerce.' 
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
  // Prosta ochrona przed botami i osobami postronnymi na czas testów
  const HOVER_AUTH_KEY = 'calqit_allowed';
  const CORRECT_PASSWORD = '111'; // <-- Tutaj wpisz hasło

  if (!sessionStorage.getItem(HOVER_AUTH_KEY)) {
    const userPass = prompt('Podaj hasło dostępowe do wersji deweloperskiej:');
    if (userPass === CORRECT_PASSWORD) {
      sessionStorage.setItem(HOVER_AUTH_KEY, 'true');
    } else {
      alert('Błędne hasło.');
      window.location.href = 'https://google.com'; // Przekierowanie intruza
    }
  }
</script>
  </head>
  <body class="font-sans bg-white">
     <Header />
    <slot />
    <Footer />
  </body>
</html>
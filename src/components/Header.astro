---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="mt-auto border-t border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    
    <div class="flex items-center gap-10">
      <div class="flex items-center">
        <a 
          href={base} 
          class="text-xl font-bold tracking-tight text-slate-900 transition-colors hover:text-slate-700"
        >
          Calqit.
        </a>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-4 text-sm font-medium text-slate-600">
        <a href={`${base}regulamin`} class="hover:text-slate-900 transition-colors">Regulamin</a>
        <a href={`${base}polityka-prywatnosci`} class="hover:text-slate-900 transition-colors">Prywatność</a>
        <a href={`${base}dostepnosc`} class="hover:text-slate-900 transition-colors">Dostępność</a>
      </nav>
    </div>

    <div class="flex items-center gap-4 text-sm text-slate-400 text-center sm:text-right">
      &copy; {currentYear} Calqit. Wszelkie prawa zastrzeżone.
    </div>
  </div>
</footer>
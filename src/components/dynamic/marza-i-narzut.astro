---
import BootstrapIcon from '../BootstrapIcon.astro';
---

<div class="border border-slate-200 rounded-xl bg-white shadow-sm overflow-hidden">
  
  <div class="bg-slate-100 border-b border-slate-200 px-6 py-3 flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Kalkulator Operacyjny</span>
    
    <div class="flex gap-1.5">
      <div class="w-3 h-3 rounded-full bg-slate-300/60"></div>
      <div class="w-3 h-3 rounded-full bg-slate-300/60"></div>
      <div class="w-3 h-3 rounded-full bg-slate-300/60"></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 md:p-8">
    
    <div class="lg:col-span-7 flex flex-col gap-6 pr-0 lg:pr-4">
      
      <div class="border-b border-slate-100 pb-3">
        <h3 class="text-base font-semibold text-slate-900">Dane wejściowe</h3>
        <p class="text-xs text-slate-500 mt-0.5">Wprowadź podstawowe parametry finansowe produktu.</p>
      </div>
      
      <div>
        <label for="mc-purchase-price" class="block text-sm font-medium text-slate-700 mb-2">
          Cena zakupu netto (PLN)
        </label>
        <div class="group flex items-stretch bg-white border border-slate-200 rounded-xl focus-within:ring-2 focus-within:ring-slate-900 focus-within:border-slate-900 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-0 border-r border-slate-200 px-3.5 text-slate-400">
            <BootstrapIcon name="cash" class="w-4 h-4" />
          </div>
          <input 
            type="number" 
            id="mc-purchase-price" 
            placeholder="np. 100" 
            min="0" 
            step="0.01"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 text-sm" 
          />
        </div>
      </div>

      <div>
        <label for="mc-vat-rate" class="block text-sm font-medium text-slate-700 mb-2">
          Stawka VAT
        </label>
        <div class="flex items-stretch bg-white border border-slate-200 rounded-xl focus-within:ring-2 focus-within:ring-slate-900 focus-within:border-slate-900 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 border-r border-slate-200 px-3.5 text-slate-400">
            <BootstrapIcon name="percent" class="w-4 h-4" />
          </div>
          <select 
            id="mc-vat-rate" 
            class="w-full px-4 py-3 bg-transparent outline-none text-slate-700 text-sm cursor-pointer"
          >
            <option value="23">23% (Podstawowa)</option>
            <option value="8">8% (Obniżona)</option>
            <option value="5">5% (Obniżona)</option>
            <option value="0">0% (Zwolniony)</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-2">Metoda kalkulacji</label>
        <div class="flex bg-slate-100 p-1 rounded-xl border border-slate-200/50">
          <label class="flex-1 text-center cursor-pointer">
            <input type="radio" name="mc-mode" value="margin" class="peer hidden" checked>
            <div class="py-2.5 text-sm font-medium text-slate-500 rounded-lg peer-checked:bg-white peer-checked:text-slate-900 peer-checked:shadow-sm peer-checked:ring-1 peer-checked:ring-slate-200/60 transition-all">
              Marża (%)
            </div>
          </label>
          <label class="flex-1 text-center cursor-pointer">
            <input type="radio" name="mc-mode" value="markup" class="peer hidden">
            <div class="py-2.5 text-sm font-medium text-slate-500 rounded-lg peer-checked:bg-white peer-checked:text-slate-900 peer-checked:shadow-sm peer-checked:ring-1 peer-checked:ring-slate-200/60 transition-all">
              Narzut (%)
            </div>
          </label>
        </div>
      </div>

      <div>
        <label for="mc-percentage" id="mc-percentage-label" class="block text-sm font-medium text-slate-700 mb-2">
          Pożądana marża (%)
        </label>
        <div class="flex items-stretch bg-white border border-slate-200 rounded-xl focus-within:ring-2 focus-within:ring-slate-900 focus-within:border-slate-900 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 border-r border-slate-200 px-3.5 text-slate-400">
            <BootstrapIcon name="sliders" class="w-4 h-4" />
          </div>
          <input 
            type="number" 
            id="mc-percentage" 
            placeholder="np. 20" 
            min="0" 
            max="99.9"
            step="0.1"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 text-sm" 
          />
        </div>
      </div>

    </div>

    <div class="lg:col-span-5 bg-slate-100 rounded-xl p-6 sm:p-8 flex flex-col justify-center gap-8 border border-gray-200">
      
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Cena sprzedaży netto</p>
        <p class="text-4xl font-bold text-slate-900 tracking-tight" id="mc-res-net-sales">0,00 zł</p>
      </div>
      
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Cena sprzedaży brutto</p>
        <p class="text-2xl font-bold text-slate-800" id="mc-res-gross-sales">0,00 zł</p>
      </div>
      
      <div class="grid grid-cols-2 gap-4 pt-6 border-t border-slate-200">
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Zysk netto</p>
          <p class="text-xl font-bold text-emerald-600" id="mc-res-profit">0,00 zł</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Kwota VAT</p>
          <p class="text-xl font-semibold text-slate-600" id="mc-res-vat">0,00 zł</p>
        </div>
      </div>
      
    </div>
    
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inputs = {
      purchase: document.getElementById('mc-purchase-price') as HTMLInputElement,
      vat: document.getElementById('mc-vat-rate') as HTMLSelectElement,
      percentage: document.getElementById('mc-percentage') as HTMLInputElement,
      radios: document.querySelectorAll('input[name="mc-mode"]') as NodeListOf<HTMLInputElement>,
      label: document.getElementById('mc-percentage-label') as HTMLLabelElement
    };

    const outputs = {
      netSales: document.getElementById('mc-res-net-sales') as HTMLParagraphElement,
      grossSales: document.getElementById('mc-res-gross-sales') as HTMLParagraphElement,
      profit: document.getElementById('mc-res-profit') as HTMLParagraphElement,
      vat: document.getElementById('mc-res-vat') as HTMLParagraphElement
    };

    const formatCurrency = (value: number) => {
      if (isNaN(value) || !isFinite(value)) return "0,00 zł";
      return new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(value);
    };

    const calculate = () => {
      const purchasePrice = parseFloat(inputs.purchase.value) || 0;
      const vatRate = parseFloat(inputs.vat.value) || 0;
      const percentage = parseFloat(inputs.percentage.value) || 0;
      
      const activeModeElement = document.querySelector('input[name="mc-mode"]:checked') as HTMLInputElement;
      const mode = activeModeElement ? activeModeElement.value : 'margin';

      let netSales = 0;

      if (mode === 'margin') {
        const safeMargin = percentage >= 100 ? 99.9 : percentage;
        netSales = purchasePrice / (1 - (safeMargin / 100));
      } else {
        netSales = purchasePrice * (1 + (percentage / 100));
      }

      const profit = netSales - purchasePrice;
      const vatAmount = netSales * (vatRate / 100);
      const grossSales = netSales + vatAmount;

      outputs.netSales.textContent = formatCurrency(netSales);
      outputs.grossSales.textContent = formatCurrency(grossSales);
      outputs.profit.textContent = formatCurrency(profit);
      outputs.vat.textContent = formatCurrency(vatAmount);
    };

    const updateLabel = () => {
      const activeModeElement = document.querySelector('input[name="mc-mode"]:checked') as HTMLInputElement;
      if (activeModeElement) {
        inputs.label.textContent = activeModeElement.value === 'margin' ? 'Pożądana marża (%)' : 'Pożądany narzut (%)';
      }
      calculate();
    };

    inputs.purchase.addEventListener('input', calculate);
    inputs.vat.addEventListener('change', calculate);
    inputs.percentage.addEventListener('input', calculate);
    
    inputs.radios.forEach(radio => {
      radio.addEventListener('change', updateLabel);
    });
  });
</script>
---
import MainLayout from 'src/layouts/MainLayout.astro';
import CalculatorCard from 'src/components/CalculatorCard.astro';
import { getCollection } from 'astro:content';
import { Search } from 'lucide-react';

// Pobieramy wszystkie kalkulatory
const allCalculators = await getCollection('calculators');

// Obliczamy liczbę kalkulatorów dla każdej kategorii (TypeScript: Record<string, number>)
const categoryCounts = allCalculators.reduce((acc, calc) => {
  const cat = calc.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const totalCount = allCalculators.length;
---

<MainLayout title="Eksploruj Kalkulatory - Calqit">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row gap-8 lg:gap-12">
      
      {/* Lewa kolumna: Panel boczny */}
      <aside class="w-full md:w-1/4 lg:w-1/5 shrink-0">
        <div class="md:sticky md:top-24">
          <h2 class="text-lg font-bold text-slate-900 mb-4 hidden md:block">Kategorie</h2>
          
          {/* Lista kategorii (Pozioma na mobile, pionowa na desktopie) */}
          <div class="flex md:flex-col gap-2 overflow-x-auto pb-4 md:pb-0 scrollbar-hide" id="category-filters">
            <button data-category="wszystko" class="category-btn flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium bg-slate-900 text-white transition-colors whitespace-nowrap">
              <span>Wszystko</span>
              <span class="ml-2 bg-white/20 text-white px-2 py-0.5 rounded-full text-xs">{totalCount}</span>
            </button>
            <button data-category="finanse" class="category-btn flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium bg-white text-slate-600 hover:bg-slate-50 border border-slate-100 transition-colors whitespace-nowrap">
              <span>Finanse</span>
              <span class="ml-2 bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full text-xs">{categoryCounts.finanse || 0}</span>
            </button>
            <button data-category="marketing" class="category-btn flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium bg-white text-slate-600 hover:bg-slate-50 border border-slate-100 transition-colors whitespace-nowrap">
              <span>Marketing</span>
              <span class="ml-2 bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full text-xs">{categoryCounts.marketing || 0}</span>
            </button>
            <button data-category="logistyka" class="category-btn flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium bg-white text-slate-600 hover:bg-slate-50 border border-slate-100 transition-colors whitespace-nowrap">
              <span>Logistyka</span>
              <span class="ml-2 bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full text-xs">{categoryCounts.logistyka || 0}</span>
            </button>
          </div>
        </div>
      </aside>

      {/* Prawa kolumna: Wyszukiwarka i Grid */}
      <main class="w-full md:w-3/4 lg:w-4/5">
        
        {/* Wyszukiwarka */}
        <div class="mb-8 relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <Search size={20} class="text-slate-400" />
          </div>
          <input 
            type="text" 
            id="search-input"
            placeholder="Szukaj kalkulatora... (np. marża)" 
            class="block w-full pl-12 pr-4 py-4 bg-white border border-slate-100 rounded-2xl leading-5 bg-transparent placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-slate-900/5 focus:border-slate-300 sm:text-sm transition-all shadow-sm"
          />
        </div>

        {/* Grid Kalkulatorów */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="calculators-grid">
          {allCalculators.map((calc) => (
            <div class="calculator-item" data-category={calc.data.category} data-title={calc.data.title.toLowerCase()} data-desc={calc.data.description.toLowerCase()}>
              <CalculatorCard 
                title={calc.data.title}
                description={calc.data.description}
                category={calc.data.category}
                icon={calc.data.icon}
                slug={calc.id} 
              />
            </div>
          ))}
        </div>

        {/* Pusty stan */}
        <div id="empty-state" class="hidden text-center py-16">
          <p class="text-slate-500 text-lg">Nie znaleziono kalkulatorów spełniających podane kryteria.</p>
        </div>
      </main>

    </div>
  </div>
</MainLayout>

<script>
  // Skrypt uruchamiany po stronie klienta
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const calculatorItems = document.querySelectorAll('.calculator-item');
    const emptyState = document.getElementById('empty-state');
    
    let currentCategory = 'wszystko';
    let searchQuery = '';

    function filterCalculators() {
      let visibleCount = 0;

      calculatorItems.forEach(item => {
        const itemCategory = item.getAttribute('data-category');
        const itemTitle = item.getAttribute('data-title') || '';
        const itemDesc = item.getAttribute('data-desc') || '';

        const matchesCategory = currentCategory === 'wszystko' || itemCategory === currentCategory;
        const matchesSearch = itemTitle.includes(searchQuery) || itemDesc.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (emptyState) {
        visibleCount === 0 ? emptyState.classList.remove('hidden') : emptyState.classList.add('hidden');
      }
    }

    // Obsługa kliknięć w kategorie
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        currentCategory = target.getAttribute('data-category') || 'wszystko';
        
        // Wizualna zmiana aktywnego przycisku
        categoryBtns.forEach(b => {
          b.className = "category-btn flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium bg-white text-slate-600 hover:bg-slate-50 border border-slate-100 transition-colors whitespace-nowrap";
          const badge = b.querySelector('span:last-child');
          if (badge) badge.className = "ml-2 bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full text-xs";
        });

        target.className = "category-btn active flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium bg-slate-900 text-white transition-colors whitespace-nowrap";
        const activeBadge = target.querySelector('span:last-child');
        if (activeBadge) activeBadge.className = "ml-2 bg-white/20 text-white px-2 py-0.5 rounded-full text-xs";

        filterCalculators();
      });
    });

    // Obsługa wpisywania w wyszukiwarkę
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase();
        filterCalculators();
      });
    }
  });
</script>
